# ~/trading-bot/etf_dukan/etf_dukan.env  -- settings for the ETF ki Dukan bot only.
# (also read, in this order: /etc/trade-config/etf_dukan.env, then the strangle bot's /etc/trade-config/config.env)
# Credentials can stay in the shared /etc/trade-config/config.env (API_KEY, CLIENT_CODE, PIN, TOTP_SECRET,
# TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, SERVICE_ACCOUNT_FILE). Put EKD_ versions here to override them,
# e.g. a separate SmartAPI app key for this bot (recommended, see README).
# chmod 600 this file.

# ---- SAFETY: keep paper mode until you've watched it for a couple of weeks ----
EKD_PAPER_MODE=1
EKD_DRY_RUN=0

# ---- optional separate credentials ----
# EKD_API_KEY=
# EKD_CLIENT_CODE=
# EKD_PIN=
# EKD_TOTP_SECRET=
# EKD_TELEGRAM_CHAT_ID=

# ---- where state, locks, logs and caches live (default: the bot folder) ----
EKD_HOME=/home/YOUR_USER/trading-bot/etf_dukan

# ---- Google Sheet ----
EKD_GSHEET_ID=1ZEWLugBHiPSsX5letLn_u7zU3dj06u9brASqJM1uo_k
EKD_SHEET_MODE=tracker      # off | log ("Bot Log" tab only) | tracker (also fills Holdings / Sold / Core / Capital input cells)

# ---- live signals from the sheet's Signals tab ----
EKD_SIGNAL_POLICY=bot       # bot: trade the bot's AngelOne plan, report sheet disagreements | agree | sheet | off
EKD_SIGNAL_IF_SHEET_DOWN=skip   # skip: no orders when the sheet can't be read | bot: trade the bot's own plan
EKD_SIGNAL_RECALC_SECS=30   # wait after writing the 3:00 pm sell before reading the buy signals
EKD_LOG_TAB=Bot Log

# ---- timing, IST ----
EKD_PLAN_TIME=14:50
EKD_SELL_TIME=15:00
EKD_BUY_TIME=15:10
EKD_LATEST_START=15:15
EKD_SELL_CUTOFF=15:09
EKD_BUY_CUTOFF=15:24

# ---- 6-monthly ETF + stock list refresh (universe_refresh.py) ----
# Runs after the 3:10 pm buys on the first trading day on/after 1 Apr and 1 Oct (and on the first run after
# install). Writes the new list to the sheet's Universe + Universe History tabs and the Watchlist Include column.
# Held counters that drop out are never sold: no new buys, target sell / averaging / Core 3x carry on.
EKD_UNIVERSE_AUTO=1             # 0 = keep universe.csv for ever
EKD_UNIVERSE_MONTHS=4,10        # refresh months (1st of the month)
EKD_UNIV_ETF_MIN_CR=1.0         # ETF must trade >= Rs 1 crore/day (median of the last ~6 months)
EKD_UNIV_MIN_DAYS=60            # and have >= 60 trading days of history
EKD_UNIV_MAX_ETFS=50            # one ETF per underlying index / commodity, most liquid first, at most 50
EKD_UNIV_MAX_STOCKS=30          # most liquid NIFTY 50 stocks ...
EKD_UNIV_MAX_FINANCIALS=4       # ... at most 4 financials
EKD_UNIV_MAX_PER_SECTOR=3       # ... at most 3 per other NSE industry
EKD_UNIV_INCUMBENT_EDGE=1.25    # names already in the list count 25% more liquid (less churn)
# EKD_UNIV_EXCLUDE=MAHKTECH,HNGSNGBEES   # never pick these
EKD_UNIVERSE_SYNC_WATCHLIST=1   # also update the tracker's Watchlist rows (input cells only)

# ---- orders ----
EKD_LIMIT_BUFFER_PCT=0.10   # limit = LTP +0.10% (buy) / -0.10% (sell)
EKD_LIMIT_WAIT_SECS=45
EKD_MARKET_FALLBACK=1       # market order for whatever the limit didn't fill
EKD_MAX_CHASE_PCT=1.0       # ...unless the price moved more than 1% from the plan
EKD_PAPER_SLIPPAGE_PCT=0.05

# ---- cash ----
EKD_BROKER_CASH_FLOOR=500000   # never let AngelOne free cash go below this (the option bot's Rs 5L buffer)

# ---- reconciliation ----
EKD_RECON_STRICT=0             # 1 = skip the whole day if AngelOne has fewer shares than the bot's records
EKD_RECON_INCLUDE_COLLATERAL=0 # set 1 only if AngelOne's holdings 'quantity' leaves out pledged shares (check with `reconcile`)

# ---- rules (final setup, Nov 2026: max 30, keep 20%; change only if you re-backtest) ----
EKD_BUY_AMOUNT=40000
EKD_AVG_AMOUNT=40000
EKD_ETF_TARGET=0.05
EKD_ETF_AVG=-0.04
EKD_STOCK_TARGET=0.08
EKD_STOCK_AVG=-0.08
EKD_SELL_FRACTION=0.8
EKD_CORE_MULTIPLE=3
EKD_MAX_POSITIONS=30
EKD_ETF_SHORTLIST=8
EKD_STOCK_SHORTLIST=2
EKD_RSI_PERIOD=14
EKD_MAX_SELLS_PER_DAY=1
EKD_MAX_AVG_PER_DAY=1
EKD_WITHDRAWAL=15000
EKD_WITHDRAW_AFTER_MONTHS=6
EKD_KEEP_BACK=15000
EKD_REBUY_GAP_DAYS=7       # a counter just sold is not bought again for 7 calendar days; 0 = same day only; -1 = off
# EKD_SYMBOL_LEVELS=GOLDBEES:0.05:-0.04,SILVERBEES:0.05:-0.04   # own target/averaging levels per symbol
